   "outputs": [],
   "source": [
    "import seaborn.objects as so\n",
    "from seaborn import load_dataset\n",
    "penguins = load_dataset(\"penguins\")"
   ]
  },
  {
   "cell_type": "raw",
   "id": "b2c2b0b3-5f3b-4e49-a02f-32b7c0d4f2e3",
   "metadata": {},
   "source": [
    "Define a plot in terms of the layers, and then use `assign` to control the global variable mappings:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c3d3c1c4-6f4c-4f5a-b13f-43c8d1e5f3f4",
   "metadata": {},
   "outputs": [],
   "source": [
    "p = so.Plot(penguins, x=\"bill_length_mm\", y=\"bill_depth_mm\")\n",
    "p.assign(color=\"species\").add(so.Dots())"
   ]
  },
  {
   "cell_type": "raw",
   "id": "d4e4d2d5-7f5d-4f6b-c24f-54d9e2f6f4f5",
   "metadata": {},
   "source": [
    "The same layer definitions can also be used with a different data source:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e5f5e3e6-8f6e-4f7c-d35f-65ea0f3a7a5a",
   "metadata": {},
   "outputs": [],
   "source": [
    "p.assign(data=penguins.query(\"island == 'Torgersen'\"))"
   ]
  }
 ],
